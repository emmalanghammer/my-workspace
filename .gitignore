.DS_Store

# Session state and local settings stay out of the repo, but the two files that
# make the preview work travel with it: without them the next person to open
# this prototype gets a server that lets their browser show them a cached copy
# of the old UI, which is the one failure that looks exactly like a bug.
.claude/*
!.claude/launch.json
!.claude/dev-server.py
!.claude/build-single.mjs
!.claude/import-tenants.mjs

# The bundler's output. Regenerate with scripts/bundle.mjs; do not send it,
# it inlines a literal </script> and breaks the pages (see build-single.mjs).
dist/
